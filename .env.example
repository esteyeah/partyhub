# Toutes ces variables sont facultatives (copie ce fichier en .env.local pour les utiliser en local).

# Préfixe d'URL quand le site est servi dans un sous-dossier (ex : GitHub Pages → /partyhub).
# Le workflow GitHub Actions le définit automatiquement.
NEXT_PUBLIC_BASE_PATH=

# Dépôt pré-rempli dans /admin pour la sauvegarde des questions (défini automatiquement par le workflow).
NEXT_PUBLIC_GITHUB_REPO=

# Pays utilisé pour chercher les extraits du Blind Test sur iTunes
NEXT_PUBLIC_ITUNES_COUNTRY=FR

# Serveur PeerJS personnel (par défaut : service public gratuit 0.peerjs.com)
NEXT_PUBLIC_PEER_HOST=
NEXT_PUBLIC_PEER_PORT=443
NEXT_PUBLIC_PEER_PATH=/
NEXT_PUBLIC_PEER_SECURE=true
