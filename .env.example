# Port HTTP (Next.js + Socket.io sur le même serveur)
PORT=3000
# Pays utilisé pour la recherche des extraits iTunes (Blind Test)
ITUNES_COUNTRY=FR

# Espace admin (/admin) pour ajouter des questions au quiz depuis le site.
# Copie ce fichier en .env.local et choisis ton nom + un mot de passe (6 caractères min).
ADMIN_NAME=
ADMIN_PASSWORD=
# Fichier où sont enregistrées les questions ajoutées depuis le site
QUESTIONS_FILE=data/custom-questions.json
