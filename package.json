{
  "name": "partyhub",
  "version": "1.0.0",
  "private": true,
  "description": "Mini-jeux multijoueurs en temps réel entre amis (Next.js + Socket.io)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore 'src/**' --ignore '.next/**' server/index.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@next/env": "^16.4.6",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.43.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
